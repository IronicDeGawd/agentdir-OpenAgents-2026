# Copy to .env.local, fill in. Never commit secrets.

# Mainnet/Sepolia RPCs (defaults to drpc.org public endpoint).
# Public eth.merkle.io rate-limits and cloudflare-eth.com lacks CCIP Read batch gateway.
MAINNET_RPC_URL=https://eth.drpc.org
SEPOLIA_RPC_URL=https://sepolia.drpc.org

# 0G testnet wallet (Galileo, chainId 16600). Fund: https://faucet.0g.ai
PRIVATE_KEY=0x

# 0G Compute Router API key. Get: https://pc.testnet.0g.ai → API Keys → inference
ZEROG_API_KEY=sk-
ZEROG_BASE_URL=https://router-api-testnet.integratenetwork.work/v1
ZEROG_MODEL=zai-org/GLM-5-FP8

# ENS write probe (optional). Sepolia name we control.
ENS_NAME=
WRITE=0

# KeeperHub org-scoped API key. Get: app.keeperhub.com → Settings → API Keys → Organisation
KH_API_KEY=kh_

# Uniswap Trading API key. Get: developers.uniswap.org
UNISWAP_API_KEY=
