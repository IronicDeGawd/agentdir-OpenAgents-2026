# Copy to .env (PM2) or .env.local (local dev). Never commit secrets.

# ── Mongo (host docker compose mongo:7) ────────────────────────────
# Root user is ops-only. App connects via the scoped app user.
MONGO_ROOT_USER=admin
MONGO_ROOT_PW=                 # openssl rand -base64 24
MONGO_APP_USER=agentdir_app
MONGO_APP_PW=                  # openssl rand -base64 24
MONGO_URL=mongodb://agentdir_app:CHANGE_ME@127.0.0.1:27017/agentdir?authSource=agentdir
MONGO_DB=agentdir

# ── Identity envelope encryption (AES-256-GCM KEK) ────────────────
# 32-byte hex. Generate: openssl rand -hex 32
# CRITICAL: this key decrypts every agent privkey at rest.
IDENTITY_KEK=
IDENTITY_KEK_VERSION=1

# ── Server wallet (iNFT minter on 0G Galileo + agentdir.eth ENS owner) ─
PRIVATE_KEY=
WALLET_ADDRESS=

# ── 0G Compute ─────────────────────────────────────────────────────
ZEROG_API_KEY=
ZEROG_BASE_URL=https://router-api-testnet.integratenetwork.work/v1
ZEROG_MODEL=qwen/qwen-2.5-7b-instruct
ZEROG_PROVIDER=

# ── Ethereum RPCs ──────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ALCHEMY_RPC_URL=
MAINNET_RPC_URL=

# ── KeeperHub (paid skills) ────────────────────────────────────────
KEEPERHUB_ORG_KEY=
KH_TURNKEY_WALLET_ID=
SEPOLIA_USDC_ADDR=

# ── iNFT contract override (optional) ──────────────────────────────
AGENTDIR_INFT_ADDRESS=

# ── Probes / dev only ──────────────────────────────────────────────
ENS_NAME=
WRITE=0
KH_API_KEY=kh_
UNISWAP_API_KEY=

# ── Misc ───────────────────────────────────────────────────────────
NODE_ENV=production

# ── Caddy on host ───────────────────────────────────────────────────
# Set in /etc/caddy/caddy.env, NOT here:
#   CLOUDFLARE_API_TOKEN=...   # Zone:Read + DNS:Edit on agentdir domain only
